# App
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# MongoDB Atlas is required so accounts and uploads are durable.
MONGODB_URI=
ALLOW_MEMORY_STORAGE=false

# Use long random values in production. Render can generate these automatically.
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_SECRET=
OTP_TTL_MINUTES=10

# Human-behaviour team login. Generate the hash locally with:
# node -e "import('bcryptjs').then(({default:b})=>b.hash(process.argv[1],12).then(console.log))" "your-password"
ANALYTICS_TEAM_EMAIL=
ANALYTICS_TEAM_PASSWORD_HASH=

# FUTURE OWNER: enter values from their own AWS account. Never commit real
# access keys to Git. On Render, add them under Service > Environment instead.
#
# AWS_REGION is the region used by SES email OTP and SNS phone OTP.
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY belong to the future owner's
# restricted application IAM user/role, never an AWS root account.
# AWS_SES_FROM_EMAIL must be an SES-verified sender.
# AWS_SNS_ORIGINATION_NUMBER is optional and must be owned/approved in SNS.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=
AWS_SNS_ORIGINATION_NUMBER=

# FUTURE OWNER MEDIA SETUP:
# 1. Deploy infra/aws-media-cdn.yaml in their AWS account with CAPABILITY_IAM.
# 2. Copy the stack outputs into the blank settings below.
# 3. Attach the output MediaApplicationManagedPolicyArn to the IAM identity
#    represented by AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# Leave AWS_S3_BUCKET blank to keep using MongoDB GridFS safely.
# AWS_S3_REGION: region where the stack was deployed, for example ap-southeast-1.
# AWS_S3_BUCKET: stack output MediaBucketName.
# AWS_S3_PREFIX: private folder used for uploaded media; normally keep "media".
# MEDIA_CDN_BASE_URL: stack output MediaCdnBaseUrl, such as https://abc.cloudfront.net.
# AWS_CLOUDFRONT_DISTRIBUTION_ID: stack output CloudFrontDistributionId.
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_PREFIX=media
MEDIA_CDN_BASE_URL=
AWS_CLOUDFRONT_DISTRIBUTION_ID=

# Media safeguards
MAX_UPLOAD_MB=250
MAX_FILES_PER_POST=20
