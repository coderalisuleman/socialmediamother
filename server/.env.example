# MongoDB Atlas is required. The root .env is loaded automatically.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
MONGODB_URI=
ALLOW_MEMORY_STORAGE=false
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# Required in production. Use a long random value (32+ bytes).
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_SECRET=
OTP_TTL_MINUTES=10

# FUTURE OWNER: keep real AWS credentials only in their hosting provider's
# secret environment settings. Never commit them or use an AWS root access key.
# Leave these blank locally to receive devOtp in the OTP request response.
# AWS_REGION is used by SES/SNS, AWS_SES_FROM_EMAIL must be SES verified, and
# AWS_SNS_ORIGINATION_NUMBER is optional.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=
AWS_SNS_ORIGINATION_NUMBER=

# FUTURE OWNER MEDIA SETUP:
# Deploy ../infra/aws-media-cdn.yaml with CAPABILITY_IAM, attach the stack's
# MediaApplicationManagedPolicyArn output to the application IAM identity, and
# copy the named outputs below. Keep AWS_S3_BUCKET blank to use MongoDB GridFS.
# AWS_S3_REGION: deployment region, for example ap-southeast-1.
# AWS_S3_BUCKET: MediaBucketName output.
# AWS_S3_PREFIX: normally "media".
# MEDIA_CDN_BASE_URL: MediaCdnBaseUrl output.
# AWS_CLOUDFRONT_DISTRIBUTION_ID: CloudFrontDistributionId output.
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_PREFIX=media
MEDIA_CDN_BASE_URL=
AWS_CLOUDFRONT_DISTRIBUTION_ID=

MAX_UPLOAD_MB=250
MAX_FILES_PER_POST=20
